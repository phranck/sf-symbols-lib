{
  "name": "sf-symbols-lib",
  "version": "1.1.3",
  "description": "SF Symbols (7,007) React components library",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hierarchical": {
      "types": "./dist/hierarchical/index.d.ts",
      "import": "./dist/hierarchical/index.js"
    },
    "./hierarchical/*": {
      "types": "./dist/hierarchical/icons/*.d.ts",
      "import": "./dist/hierarchical/icons/*.js"
    },
    "./monochrome": {
      "types": "./dist/monochrome/index.d.ts",
      "import": "./dist/monochrome/index.js"
    },
    "./monochrome/*": {
      "types": "./dist/monochrome/icons/*.d.ts",
      "import": "./dist/monochrome/icons/*.js"
    },
    "./palette": {
      "types": "./dist/palette/index.d.ts",
      "import": "./dist/palette/index.js"
    },
    "./palette/*": {
      "types": "./dist/palette/icons/*.d.ts",
      "import": "./dist/palette/icons/*.js"
    },
    "./multicolor": {
      "types": "./dist/multicolor/index.d.ts",
      "import": "./dist/multicolor/index.js"
    },
    "./multicolor/*": {
      "types": "./dist/multicolor/icons/*.d.ts",
      "import": "./dist/multicolor/icons/*.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phranck/sf-symbols-lib"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build && tsc --emitDeclarationOnly && tsc-alias",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate-sfsymbols.ts",
    "clean": "rm -rf src/hierarchical src/monochrome src/palette src/multicolor src/compat src/components/sf-symbol-name.ts src/index.ts docs/dist dist",
    "check": "npm run lint && npm run typecheck && npm run build",
    "docs:generate": "tsx scripts/generate-docs-data.ts",
    "docs:serve": "browser-sync start --server docs/dist --files docs/dist/index.html --no-open",
    "docs:preview": "npm run docs:generate && npm run docs:serve"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/clean-css": "^4.2.11",
    "@types/node": "^25.0.6",
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "browser-sync": "^3.0.4",
    "clean-css": "^5.3.3",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "marked": "^15.0.0",
    "terser": "^5.20.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.0.0"
  }
}
